  company      Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "delivery_note_print_events_company_id_fkey")
  deliveryNote DeliveryNote             @relation(fields: [deliveryNoteId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict, map: "delivery_note_print_events_delivery_note_company_fkey")
  printVersion DeliveryNotePrintVersion @relation(fields: [printVersionId, deliveryNoteId, companyId], references: [id, deliveryNoteId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "delivery_note_print_events_version_note_company_fkey")
  actorUser    User                     @relation("DeliveryNotePrintEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "delivery_note_print_events_actor_user_id_fkey")
  session      UserSession              @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "delivery_note_print_events_session_id_fkey")

  @@index([deliveryNoteId, occurredAt(sort: Desc), id], map: "delivery_note_print_events_note_occurred_idx")
  @@index([companyId, occurredAt(sort: Desc)], map: "delivery_note_print_events_company_occurred_idx")
  @@index([printVersionId], map: "delivery_note_print_events_print_version_idx")
  @@index([actorUserId], map: "delivery_note_print_events_actor_idx")
  @@index([sessionId], map: "delivery_note_print_events_session_idx")
  @@map("delivery_note_print_events")
}

model DeliveryNoteLine {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryNoteId   String   @map("delivery_note_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  lineNumber       Int      @map("line_number")
  salesOrderLineId String   @map("sales_order_line_id") @db.Uuid
  itemId           String   @map("item_id") @db.Uuid
  itemSnapshot     Json     @map("item_snapshot")
  priceSnapshot    Json     @map("price_snapshot")
  quantity         Decimal  @db.Decimal(18, 4)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(18, 5)
  lineAmount       Decimal  @map("line_amount") @db.Decimal(18, 0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById      String   @map("created_by") @db.Uuid

  deliveryNote   DeliveryNote   @relation(fields: [deliveryNoteId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  item           Item           @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  itemCompany    ItemCompany    @relation(fields: [itemId, companyId], references: [itemId, companyId], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User           @relation("DeliveryNoteLineCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([deliveryNoteId, lineNumber], map: "delivery_note_lines_note_line_key")
  @@index([salesOrderLineId], map: "delivery_note_lines_order_line_idx")
  @@index([companyId, itemId, deliveryNoteId], map: "delivery_note_lines_company_item_note_idx")
  @@map("delivery_note_lines")
}

model MigrationBatch {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String               @map("company_id") @db.Uuid
  sourceSystem   String               @map("source_system") @db.VarChar(50)
  entityType     String               @map("entity_type") @db.VarChar(100)
  sourceFileName String               @map("source_file_name") @db.VarChar(255)
  sourceFileHash String               @map("source_file_hash") @db.Char(64)
  status         MigrationBatchStatus @default(PENDING)
  dryRun         Boolean              @default(true) @map("dry_run")
  startedAt      DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?            @map("completed_at") @db.Timestamptz(3)
  initiatedById  String               @map("initiated_by") @db.Uuid
  correlationId  String               @map("correlation_id") @db.VarChar(100)
  totalCount     Int                  @default(0) @map("total_count")
  validCount     Int                  @default(0) @map("valid_count")
  importedCount  Int                  @default(0) @map("imported_count")
  skippedCount   Int                  @default(0) @map("skipped_count")
  failedCount    Int                  @default(0) @map("failed_count")
  summaryJson    Json?                @map("summary_json")
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  initiatedBy     User                      @relation("MigrationBatchInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legacyMappings  LegacyIdMap[]
  issues          MigrationIssue[]
  reconciliations MigrationReconciliation[]

  @@unique([companyId, sourceSystem, entityType, sourceFileHash, dryRun], map: "migration_batches_company_source_entity_hash_dry_key")
  @@index([companyId, status, startedAt(sort: Desc)], map: "migration_batches_company_status_started_idx")
  @@index([initiatedById, startedAt(sort: Desc)], map: "migration_batches_initiator_started_idx")
  @@map("migration_batches")
}

model LegacyIdMap {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceSystem     String   @map("source_system") @db.VarChar(50)
  entityType       String   @map("entity_type") @db.VarChar(100)
  legacyId         String   @map("legacy_id") @db.VarChar(255)
  localId          String   @map("local_id") @db.Uuid
  migrationBatchId String   @map("migration_batch_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  migrationBatch MigrationBatch @relation(fields: [migrationBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sourceSystem, entityType, legacyId], map: "legacy_id_map_source_entity_legacy_key")
  @@index([entityType, localId], map: "legacy_id_map_entity_local_idx")
  @@index([migrationBatchId], map: "legacy_id_map_batch_idx")
  @@map("legacy_id_map")
}

model MigrationIssue {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  migrationBatchId String                    @map("migration_batch_id") @db.Uuid
  rowNumber        Int?                      @map("row_number")
  legacyId         String?                   @map("legacy_id") @db.VarChar(255)
  severity         MigrationIssueSeverity
  issueCode        String                    @map("issue_code") @db.VarChar(100)
  message          String                    @db.VarChar(500)
  sourceDataJson   Json?                     @map("source_data_json")
  resolutionStatus MigrationResolutionStatus @default(OPEN) @map("resolution_status")
  resolvedById     String?                   @map("resolved_by") @db.Uuid
  resolvedAt       DateTime?                 @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  migrationBatch MigrationBatch @relation(fields: [migrationBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy     User?          @relation("MigrationIssueResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([migrationBatchId, severity, resolutionStatus], map: "migration_issues_batch_severity_resolution_idx")
  @@index([resolutionStatus, createdAt], map: "migration_issues_resolution_created_idx")
  @@map("migration_issues")
}

model MigrationReconciliation {
  id                   String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  migrationBatchId     String                        @map("migration_batch_id") @db.Uuid
  entityType           String                        @map("entity_type") @db.VarChar(100)
  sourceCount          Int                           @map("source_count")
  importedCount        Int                           @map("imported_count")
  skippedCount         Int                           @map("skipped_count")
  failedCount          Int                           @map("failed_count")
  reconciliationStatus MigrationReconciliationStatus @map("reconciliation_status")
  detailsJson          Json?                         @map("details_json")
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)

  migrationBatch MigrationBatch @relation(fields: [migrationBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([migrationBatchId, entityType], map: "migration_reconciliations_batch_entity_key")
  @@index([reconciliationStatus, createdAt], map: "migration_reconciliations_status_created_idx")
  @@map("migration_reconciliations")
}
