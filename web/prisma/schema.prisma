generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED

  @@map("idempotency_status")
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER

  @@map("background_job_status")
}

enum CustomerType {
  DOMESTIC
  FOREIGN

  @@map("customer_type")
}

enum ItemType {
  PRODUCT
  RAW_MATERIAL

  @@map("item_type")
}

enum FreightMode {
  NO_CHARGE
  QUANTITY_BASED
  FIXED_PER_LOCATION

  @@map("freight_mode")
}

model Company {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String       @unique(map: "companies_code_key") @db.VarChar(32)
  name      String       @db.VarChar(200)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings          CompanySetting[]
  userScopes        UserCompanyScope[]
  documentSequences DocumentSequence[]
  idempotencyKeys   IdempotencyKey[]
  backgroundJobs    BackgroundJob[]
  auditLogs         AuditLog[]
  defaultForUsers   User[]             @relation("UserDefaultCompany")
  selectedSessions  UserSession[]      @relation("SessionSelectedCompany")
  customerRelations CustomerCompany[]
  itemRelations     ItemCompany[]
  priceLists        PriceList[]

  @@index([status, name], map: "companies_status_name_idx")
  @@map("companies")
}

model CompanySetting {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  settingKey    String   @map("setting_key") @db.VarChar(100)
  settingValue  Json     @map("setting_value")
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, settingKey, effectiveFrom], map: "company_settings_company_key_effective_key")
  @@index([companyId, settingKey, effectiveFrom(sort: Desc)], map: "company_settings_lookup_idx")
  @@map("company_settings")
}

model User {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username            String       @db.VarChar(100)
  normalizedUsername  String       @unique(map: "users_normalized_username_key") @map("normalized_username") @db.VarChar(100)
  passwordHash        String       @map("password_hash") @db.VarChar(255)
  status              RecordStatus @default(ACTIVE)
  failedLoginAttempts Int          @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?    @map("locked_until") @db.Timestamptz(3)
  defaultCompanyId    String?      @map("default_company_id") @db.Uuid
  lastActiveAt        DateTime?    @map("last_active_at") @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleAssignments UserRole[]
  companyScopes   UserCompanyScope[]
  sessions        UserSession[]
  idempotencyKeys IdempotencyKey[]
  auditLogs       AuditLog[]         @relation("AuditActor")
  customersCreated Customer[]        @relation("CustomerCreatedBy")
  customersUpdated Customer[]        @relation("CustomerUpdatedBy")
  customerCompaniesCreated CustomerCompany[] @relation("CustomerCompanyCreatedBy")
  customerCompaniesUpdated CustomerCompany[] @relation("CustomerCompanyUpdatedBy")
  customerContactsCreated CustomerContact[] @relation("CustomerContactCreatedBy")
  customerContactsUpdated CustomerContact[] @relation("CustomerContactUpdatedBy")
  deliveryLocationsCreated DeliveryLocation[] @relation("DeliveryLocationCreatedBy")
  deliveryLocationsUpdated DeliveryLocation[] @relation("DeliveryLocationUpdatedBy")
  itemsCreated      Item[]             @relation("ItemCreatedBy")
  itemsUpdated      Item[]             @relation("ItemUpdatedBy")
  itemCompaniesCreated ItemCompany[]   @relation("ItemCompanyCreatedBy")
  itemCompaniesUpdated ItemCompany[]   @relation("ItemCompanyUpdatedBy")
  priceListsCreated PriceList[]         @relation("PriceListCreatedBy")
  priceListsUpdated PriceList[]         @relation("PriceListUpdatedBy")
  itemPricesCreated ItemPrice[]         @relation("ItemPriceCreatedBy")
  itemPricesUpdated ItemPrice[]         @relation("ItemPriceUpdatedBy")
  priceAssignmentsCreated CustomerPriceListAssignment[] @relation("PriceAssignmentCreatedBy")
  priceAssignmentsUpdated CustomerPriceListAssignment[] @relation("PriceAssignmentUpdatedBy")
  freightRulesCreated FreightRule[] @relation("FreightRuleCreatedBy")
  freightRulesUpdated FreightRule[] @relation("FreightRuleUpdatedBy")
  defaultCompany  Company?           @relation("UserDefaultCompany", fields: [defaultCompanyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status], map: "users_status_idx")
  @@index([lastActiveAt], map: "users_last_active_at_idx")
  @@index([lockedUntil], map: "users_locked_until_idx")
  @@index([defaultCompanyId], map: "users_default_company_id_idx")
  @@map("users")
}

model Role {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String       @unique(map: "roles_code_key") @db.VarChar(50)
  name      String       @db.VarChar(100)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  userAssignments UserRole[]

  @@index([status], map: "roles_status_idx")
  @@map("roles")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, roleId], map: "user_roles_user_role_key")
  @@index([roleId, userId], map: "user_roles_role_user_idx")
  @@map("user_roles")
}

model UserCompanyScope {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, companyId], map: "user_company_scopes_user_company_key")
  @@index([companyId, userId], map: "user_company_scopes_company_user_idx")
  @@map("user_company_scopes")
}

model UserSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique(map: "user_sessions_token_hash_key") @map("token_hash") @db.VarChar(255)
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP + '08:00:00'::interval)")) @map("idle_expires_at") @db.Timestamptz(3)
  selectedCompanyId String?   @map("selected_company_id") @db.Uuid
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(255)
  clientMetadata    Json?     @map("client_metadata")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selectedCompany Company?   @relation("SessionSelectedCompany", fields: [selectedCompanyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  auditLogs       AuditLog[]

  @@index([userId, revokedAt], map: "user_sessions_user_revoked_idx")
  @@index([idleExpiresAt], map: "user_sessions_idle_expires_idx")
  @@index([selectedCompanyId], map: "user_sessions_selected_company_id_idx")
  @@map("user_sessions")
}

model DocumentSequence {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  fiscalYear   Int      @map("fiscal_year")
  documentType String   @map("document_type") @db.VarChar(64)
  lastValue    BigInt   @default(0) @map("last_value")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, fiscalYear, documentType], map: "document_sequences_company_year_type_key")
  @@index([documentType, fiscalYear], map: "document_sequences_type_year_idx")
  @@map("document_sequences")
}

model IdempotencyKey {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  operation        String            @db.VarChar(100)
  idempotencyKey   String            @map("idempotency_key") @db.VarChar(255)
  requestHash      String            @map("request_hash") @db.VarChar(255)
  status           IdempotencyStatus @default(PROCESSING)
  responseStatus   Int?              @map("response_status")
  responseMetadata Json?             @map("response_metadata")
  resultReference  String?           @map("result_reference") @db.VarChar(255)
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(3)
  startedAt        DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(3)
  failedAt         DateTime?         @map("failed_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, operation, idempotencyKey], map: "idempotency_keys_company_operation_key")
  @@index([expiresAt], map: "idempotency_keys_expires_at_idx")
  @@index([status, startedAt], map: "idempotency_keys_status_started_idx")
  @@index([userId, createdAt(sort: Desc)], map: "idempotency_keys_user_created_idx")
  @@map("idempotency_keys")
}

model BackgroundJob {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String?             @map("company_id") @db.Uuid
  jobType          String              @map("job_type") @db.VarChar(100)
  payload          Json
  status           BackgroundJobStatus @default(PENDING)
  availableAt      DateTime            @default(now()) @map("available_at") @db.Timestamptz(3)
  attemptCount     Int                 @default(0) @map("attempt_count")
  maxAttempts      Int                 @default(5) @map("max_attempts")
  lockedAt         DateTime?           @map("locked_at") @db.Timestamptz(3)
  lockedBy         String?             @map("locked_by") @db.VarChar(100)
  deduplicationKey String?             @map("deduplication_key") @db.VarChar(255)
  correlationId    String?             @map("correlation_id") @db.VarChar(100)
  lastError        String?             @map("last_error")
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(3)
  failedAt         DateTime?           @map("failed_at") @db.Timestamptz(3)
  deadLetteredAt   DateTime?           @map("dead_lettered_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, availableAt], map: "background_jobs_status_available_idx")
  @@index([status, lockedAt], map: "background_jobs_status_locked_idx")
  @@index([jobType, createdAt(sort: Desc)], map: "background_jobs_type_created_idx")
  @@map("background_jobs")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  sessionId   String?  @map("session_id") @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String   @map("entity_id") @db.Uuid
  operation   String   @db.VarChar(100)
  reason      String?
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  metadata    Json?
  requestId   String   @map("request_id") @db.VarChar(100)
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  company   Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session   UserSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([entityType, entityId, occurredAt(sort: Desc)], map: "audit_logs_entity_occurred_idx")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "audit_logs_actor_occurred_idx")
  @@index([sessionId, occurredAt(sort: Desc)], map: "audit_logs_session_occurred_idx")
  @@index([requestId, occurredAt(sort: Desc)], map: "audit_logs_request_occurred_idx")
  @@index([companyId, occurredAt(sort: Desc)], map: "audit_logs_company_occurred_idx")
  @@map("audit_logs")
}

model WorkerHeartbeat {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId        String   @unique(map: "worker_heartbeats_worker_id_key") @map("worker_id") @db.VarChar(100)
  status          String   @db.VarChar(32)
  startedAt       DateTime @map("started_at") @db.Timestamptz(3)
  lastHeartbeatAt DateTime @map("last_heartbeat_at") @db.Timestamptz(3)
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, lastHeartbeatAt], map: "worker_heartbeats_status_last_idx")
  @@map("worker_heartbeats")
}

model Customer {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerType          CustomerType @map("customer_type")
  name                  String       @db.VarChar(200)
  taxId                 String?      @map("tax_id") @db.VarChar(32)
  normalizedTaxId       String?      @map("normalized_tax_id") @db.VarChar(32)
  countryCode           String?      @map("country_code") @db.VarChar(2)
  foreignIdentifier     String?      @map("foreign_identifier") @db.VarChar(100)
  status                RecordStatus @default(ACTIVE)
  createdById           String       @map("created_by") @db.Uuid
  updatedById           String       @map("updated_by") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy         User               @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy         User               @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  companyRelations  CustomerCompany[]
  contacts          CustomerContact[]
  deliveryLocations DeliveryLocation[]
  priceAssignments  CustomerPriceListAssignment[]

  @@index([status, name], map: "customers_status_name_idx")
  @@index([customerType, status], map: "customers_type_status_idx")
  @@unique([countryCode, foreignIdentifier], map: "customers_country_foreign_identifier_key")
  @@map("customers")
}

model CustomerCompany {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId             String       @map("customer_id") @db.Uuid
  companyId              String       @map("company_id") @db.Uuid
  customerCode           String       @map("customer_code") @db.VarChar(50)
  normalizedCustomerCode String       @map("normalized_customer_code") @db.VarChar(50)
  status                 RecordStatus @default(ACTIVE)
  createdById            String       @map("created_by") @db.Uuid
  updatedById            String       @map("updated_by") @db.Uuid
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User     @relation("CustomerCompanyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User     @relation("CustomerCompanyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  priceAssignments CustomerPriceListAssignment[]
  freightRules     FreightRule[]

  @@unique([customerId, companyId], map: "customer_companies_customer_company_key")
  @@unique([companyId, normalizedCustomerCode], map: "customer_companies_company_code_key")
  @@index([companyId, status, customerId], map: "customer_companies_company_status_customer_idx")
  @@index([customerId, status], map: "customer_companies_customer_status_idx")
  @@map("customer_companies")
}

model CustomerContact {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  name        String       @db.VarChar(200)
  department  String?      @db.VarChar(100)
  jobTitle    String?      @map("job_title") @db.VarChar(100)
  phone       String?      @db.VarChar(50)
  mobile      String?      @db.VarChar(50)
  email       String?      @db.VarChar(320)
  notes       String?
  isPrimary   Boolean      @default(false) @map("is_primary")
  status      RecordStatus @default(ACTIVE)
  createdById String       @map("created_by") @db.Uuid
  updatedById String       @map("updated_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User     @relation("CustomerContactCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User     @relation("CustomerContactUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([customerId, status, isPrimary(sort: Desc)], map: "customer_contacts_customer_status_primary_idx")
  @@index([email], map: "customer_contacts_email_idx")
  @@map("customer_contacts")
}

model DeliveryLocation {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String       @map("customer_id") @db.Uuid
  code          String       @db.VarChar(50)
  name          String       @db.VarChar(200)
  recipientName String       @map("recipient_name") @db.VarChar(200)
  phone         String       @db.VarChar(50)
  postalCode    String?      @map("postal_code") @db.VarChar(20)
  city          String?      @db.VarChar(100)
  district      String?      @db.VarChar(100)
  addressLine   String       @map("address_line") @db.VarChar(300)
  fullAddress   String       @map("full_address") @db.VarChar(500)
  notes         String?
  isDefault     Boolean      @default(false) @map("is_default")
  status        RecordStatus @default(ACTIVE)
  createdById   String       @map("created_by") @db.Uuid
  updatedById   String       @map("updated_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User     @relation("DeliveryLocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User     @relation("DeliveryLocationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  freightRules FreightRule[]

  @@unique([customerId, code], map: "delivery_locations_customer_code_key")
  @@unique([id, customerId], map: "delivery_locations_id_customer_key")
  @@index([customerId, status, isDefault(sort: Desc)], map: "delivery_locations_customer_status_default_idx")
  @@index([city, district], map: "delivery_locations_city_district_idx")
  @@map("delivery_locations")
}

model Item {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String       @db.VarChar(100)
  normalizedCode    String       @unique(map: "items_normalized_code_key") @map("normalized_code") @db.VarChar(100)
  name              String       @db.VarChar(200)
  description       String?
  specification     String?
  baseUnit          String       @map("base_unit") @db.VarChar(50)
  barcode           String?      @db.VarChar(100)
  itemType          ItemType     @map("item_type")
  salesEnabled      Boolean      @default(false) @map("sales_enabled")
  purchaseEnabled   Boolean      @default(false) @map("purchase_enabled")
  inventoryEnabled  Boolean      @default(false) @map("inventory_enabled")
  productionEnabled Boolean      @default(false) @map("production_enabled")
  status            RecordStatus @default(ACTIVE)
  createdById       String       @map("created_by") @db.Uuid
  updatedById       String       @map("updated_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy        User          @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy        User          @relation("ItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  companyRelations ItemCompany[]
  prices           ItemPrice[]

  @@index([status, salesEnabled, itemType, name], map: "items_status_sales_type_name_idx")
  @@index([itemType, status, name], map: "items_type_status_name_idx")
  @@map("items")
}

model ItemCompany {
  id                        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId                    String       @map("item_id") @db.Uuid
  companyId                 String       @map("company_id") @db.Uuid
  companyItemCode           String       @map("company_item_code") @db.VarChar(100)
  normalizedCompanyItemCode String       @map("normalized_company_item_code") @db.VarChar(100)
  salesEnabled              Boolean      @default(false) @map("sales_enabled")
  status                    RecordStatus @default(ACTIVE)
  createdById               String       @map("created_by") @db.Uuid
  updatedById               String       @map("updated_by") @db.Uuid
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  item      Item    @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User    @relation("ItemCompanyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User    @relation("ItemCompanyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([itemId, companyId], map: "item_companies_item_company_key")
  @@unique([companyId, normalizedCompanyItemCode], map: "item_companies_company_code_key")
  @@index([companyId, status, salesEnabled, itemId], map: "item_companies_company_status_sales_item_idx")
  @@index([itemId, status], map: "item_companies_item_status_idx")
  @@map("item_companies")
}

model PriceList {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  code           String       @db.VarChar(100)
  normalizedCode String       @map("normalized_code") @db.VarChar(100)
  name           String       @db.VarChar(200)
  status         RecordStatus @default(ACTIVE)
  createdById    String       @map("created_by") @db.Uuid
  updatedById    String       @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy   User                          @relation("PriceListCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy   User                          @relation("PriceListUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  itemPrices  ItemPrice[]
  assignments CustomerPriceListAssignment[]

  @@unique([companyId, normalizedCode], map: "price_lists_company_code_key")
  @@unique([id, companyId], map: "price_lists_id_company_key")
  @@index([companyId, status, name], map: "price_lists_company_status_name_idx")
  @@map("price_lists")
}

model ItemPrice {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  priceListId   String       @map("price_list_id") @db.Uuid
  itemId        String       @map("item_id") @db.Uuid
  unitPrice     Decimal      @map("unit_price") @db.Decimal(18, 5)
  validFrom     DateTime     @map("valid_from") @db.Date
  validTo       DateTime?    @map("valid_to") @db.Date
  status        RecordStatus @default(ACTIVE)
  createdById   String       @map("created_by") @db.Uuid
  updatedById   String       @map("updated_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User      @relation("ItemPriceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User      @relation("ItemPriceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([priceListId, itemId, validFrom(sort: Desc)], map: "item_prices_lookup_idx")
  @@index([itemId, status, validFrom, validTo], map: "item_prices_item_status_period_idx")
  @@map("item_prices")
}

model CustomerPriceListAssignment {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  priceListId String       @map("price_list_id") @db.Uuid
  validFrom   DateTime     @map("valid_from") @db.Date
  validTo     DateTime?    @map("valid_to") @db.Date
  status      RecordStatus @default(ACTIVE)
  createdById String       @map("created_by") @db.Uuid
  updatedById String       @map("updated_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerCompany CustomerCompany @relation(fields: [customerId, companyId], references: [customerId, companyId], onDelete: Restrict, onUpdate: Restrict)
  priceList       PriceList       @relation(fields: [priceListId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User            @relation("PriceAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy       User            @relation("PriceAssignmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([customerId, companyId, validFrom(sort: Desc)], map: "price_assignments_customer_company_lookup_idx")
  @@index([priceListId, companyId, validFrom, validTo], map: "price_assignments_price_list_period_idx")
  @@map("customer_price_list_assignments")
}

model FreightRule {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId         String       @map("customer_id") @db.Uuid
  companyId          String       @map("company_id") @db.Uuid
  deliveryLocationId String       @map("delivery_location_id") @db.Uuid
  mode               FreightMode
  unitFreight        Decimal?     @map("unit_freight") @db.Decimal(18, 0)
  fixedFreight       Decimal?     @map("fixed_freight") @db.Decimal(18, 0)
  validFrom          DateTime     @map("valid_from") @db.Date
  validTo            DateTime?    @map("valid_to") @db.Date
  status             RecordStatus @default(ACTIVE)
  createdById        String       @map("created_by") @db.Uuid
  updatedById        String       @map("updated_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customerCompany CustomerCompany @relation(fields: [customerId, companyId], references: [customerId, companyId], onDelete: Restrict, onUpdate: Restrict)
  deliveryLocation DeliveryLocation @relation(fields: [deliveryLocationId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("FreightRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User @relation("FreightRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([companyId, customerId, deliveryLocationId, status, validFrom, validTo], map: "freight_rules_lookup_idx")
  @@index([companyId, customerId, deliveryLocationId, validFrom(sort: Desc)], map: "freight_rules_history_idx")
  @@map("freight_rules")
}
