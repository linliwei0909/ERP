{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --project tsconfig.typecheck.json",
    "test": "vitest run tests/unit --exclude tests/unit/delivery-note-print.test.ts && vitest run tests/unit/delivery-note-print.test.ts --maxWorkers=1",
    "test:db": "vitest run tests/db --maxWorkers=1",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:create-only": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "bootstrap:company-settings": "tsx scripts/bootstrap-company-settings.ts",
    "db:fingerprint": "pwsh -NoProfile -File scripts/db-fingerprint.ps1",
    "db:backup": "pwsh -NoProfile -File scripts/backup-development-db.ps1",
    "db:restore-verify": "pwsh -NoProfile -File scripts/restore-verify-development-db.ps1"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^26.1.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
